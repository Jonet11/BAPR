--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 8
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01a0c02cbc84dd6468a48f692f67316c, type: 3}
  m_Name: magic_note
  m_EditorClassIdentifier: 
  Sheet1:
  - name: "\uC544\uBC84\uC9C0?"
    text: "\uAC00\uB054 \uAFC8\uC5D0 \uB098\uC624\uB294 \uC0AC\uB78C\uC73C\uB85C,
      \uB0B4 \uCE5C\uBD80\uC778 \uB4EF \uD558\uB2E4.\n\uAFC8\uC740 \uC6D0\uB798 \uAE30\uC5B5\uC744
      \uC798 \uBABB\uD55C\uB2E4\uB9CC \uC5EC\uB7EC \uBC88 \uAFB8\uB2E4 \uBCF4\uB2C8
      \uB0B4\uC6A9\uC744 \uB2E4 \uC678\uC6CC\uBC84\uB838\uB2E4.\n\uB0B4\uC6A9\uC744
      \uB300\uCDA9 \uC694\uC57D\uD558\uC790\uBA74 \uAF64\uB098 \uB192\uC740 \uC0AC\uB78C\uC778
      \uC544\uBC84\uC9C0\uC640 \uC880 \uB354 \uC5B4\uB838\uC744 \uB54C\uC758 \uB0B4\uAC00
      \uBD80\uC790\uAC04\uC758 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uB294 \uAFC8\uC774\uB2E4.\n\uC61B\uB0A0
      \uAE30\uC5B5\uC740 \uCC3E\uB4E0 \uB9D0\uB4E0 \uBCC4\uB85C \uC0C1\uAD00\uC5C6\uACA0\uB2E4
      \uC2F6\uC5B4\uB3C4 \uC544\uBC84\uC9C0\uB780 \uBD84\uC740 \uB9CC\uB098\uBCF4\uACE0
      \uC2F6\uB2E4."
    birthday: "\uBAB0\uB77C"
  - name: "\uD0C0\uB85C"
    text: "\uC81C\uBAA9\uC5D0 \uC544\uC800\uC528\uB77C\uB294 \uD638\uCE6D\uB3C4 \uBD99\uC5EC\uC57C
      \uD560\uAE4C? \uC544\uB2C8, \uADF8\uB798\uB3C4, \uBC84\uB987\uC5C6\uC774 \uBD80\uB974\uB294
      \uAC83\uB3C4 \uC544\uB2C8\uACE0 \uAE30\uB85D\uC744 \uC704\uD55C \uAC70\uB2C8\uAE4C
      \uAD1C\uCC2E\uACA0\uC9C0.\n\uAE30\uC5B5\uC744 \uC783\uACE0 \uB9C8\uB974\uBCA8\uC5D0
      \uC4F0\uB7EC\uC838\uC788\uB358 \uB098\uB97C \uAC70\uB450\uC5B4 \uC8FC\uC2E0
      \uACE0\uB9C8\uC6B0\uC2E0 \uBD84\uC774\uB2E4.\n'\uBC14\uB974\uACE0\uB124\uC2A4'\uB77C\uB294
      \uC74C\uC2DD\uC810\uC744 \uD558\uACE0 \uACC4\uC154\uC11C \uB098\uB294 \uC7AC\uB8CC
      \uC870\uB2EC\uC774\uB098 \uD68C\uACC4 \uB4F1 \uC5EC\uB7EC \uC77C\uC744 \uB3D5\uACE0
      \uC788\uB2E4. \uC694\uB9AC\uC5D0\uB294 \uBCC4\uB85C \uC18C\uC9C8\uC774 \uC5C6\uC5C8\uB2E4..\n\n\uC7A5\uB09C\uAE30\uAC00
      \uAF64 \uC788\uC73C\uC2DC\uB2E4. \uC21C\uCC30 \uB54C\uBB38\uC5D0 \uD56D\uC0C1
      \uB2A6\uC7A0\uC790\uB294 \uB098\uB97C \uAE68\uC6B0\uB824 \uC628\uAC16 \uC218\uB97C
      \uB2E4 \uC4F0\uC2E0\uB2E4. \uC5B4\uB5A8 \uB550 \uBB3C\uB85C, \uC5B4\uB5A8 \uB550
      \uC606\uC9D1 \uC544\uC774\uB97C \uB370\uB824\uC640 \uBC14\uC774\uC62C\uB9B0\uC744
      \uD0A4\uACE0.. \uB9E4\uC77C\uB9C8\uB2E4 \uB2E4\uB974\uAC8C..!\n\uADF8\uB807\uC9C0\uB9CC
      \uC5B4\uB824\uC6B4 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294 \uC694\uB9AC\uB3C4
      \uADF8\uB0E5 \uC81C\uACF5\uD574\uC8FC\uC2E0\uB2E4. \uBD09\uC0AC\uD65C\uB3D9\uB3C4
      \uC9C4\uD589\uD558\uC2DC\uBA70 \uC0DD\uC120..\uC870\uB9BC\uC774\uB791 \uB5A1\uB3C4
      \uB098\uB204\uC5B4\uC8FC\uC2E0\uB2E4. \uC120\uD55C \uBD84\uC774\uB2E4. \uC0AC\uB78C\uB4E4\uC774
      \uB2E4\uB4E4 \uC544\uC800\uC528\uB97C \uC88B\uAC8C \uB9D0\uD560 \uB54C\uB9C8\uB2E4
      \uB0B4\uC2EC \uB098\uB3C4 \uAE30\uBD84\uC774 \uC88B\uB2E4.\n\uADF8\uB7F0 \uD589\uC0AC\uAC00
      \uB05D\uB098\uACE0 \uB098\uBA74 \uC77C\uC740 \uB2E4 \uB098\uB791 \uC138\uB7FD\uC5D0\uAC8C
      \uB9E1\uAE30\uACE0 \uC790\uB7EC \uAC04\uB2E4\uB9CC..\n\uADC0\uCC2E\uC740 \uC77C\uC740
      \uB0A8\uC5D0\uAC8C \uB5A0\uB118\uAE30\uB294 \uAC83\uB9CC \uBE7C\uBA74, \uADF8\uAC83\uB9CC
      \uBE7C\uBA74 \uC874\uACBD\uC2A4\uB7EC\uC6B0\uC2E0 \uBD84\uC774\uB2E4.\n\n\uC0DD\uC120
      \uD0C0\uCF54\uC5D0 \uC774\uC0C1\uD558\uAC8C \uC790\uBD80\uC2EC\uC744 \uAC00\uC9C0\uACE0
      \uC788\uB2E4.\n\uB098\uB294 \uADF8\uB7ED\uC800\uB7ED \uBA39\uC744 \uB9CC \uD588\uB2E4\uB9CC
      \uC190\uB2D8\uB4E4\uC740 \uADF8\uB807\uC9C0 \uC54A\uC740 \uBAA8\uC591\uC774\uB2E4.\n\uC138\uB7FD\uC758
      \uC0DD\uC120 \uC870\uB9BC\uC774 \uB354 \uC720\uBA85\uD574\uC838\uC11C \uBA54\uB274\uD310\uC758
      \uC0DD\uC120 \uD0C0\uCF54\uB97C \uB0B4\uB9B4 \uB54C \uC0B4\uC9DD \uC6B0\uB294
      \uAC78 \uBCF8 \uAC83 \uAC19\uB2E4.\n\n\uC5D0\uB974\uD06C \uC544\uC800\uC528\uB791\uC740
      \uC624\uB798\uC804\uBD80\uD130 \uC54C\uB358 \uC0AC\uC774\uC778 \uB4EF? \uB098\uC911\uC5D0
      \uBB3C\uC5B4\uBD10\uC57C\uACA0\uB2E4.\n\n\uADFC\uB370 \uBA87 \uC0B4\uC774\uC2DC\uC9C0?\n\n"
    birthday: 46381
  - name: "\uC138\uB7FD"
    text: "\uB098\uBCF4\uB2E4 \uBA3C\uC800 \uBC14\uB974\uACE0\uB124\uC2A4\uC5D0\uC11C
      \uC77C\uC744 \uC2DC\uC791\uD55C \uC5EC\uC790\uC560.\n\uC131\uC2E4\uD55C \uC560\uB2E4.
      \uC8FC\uBC29\uC5D0\uC11C \uC77C\uD558\uB294\uB370 \uBA54\uB274\uAC00 \uBC00\uB9AC\uB294
      \uAC78 \uBCF8 \uC801\uC774 \uC5C6\uB2E4.\n\uD558\uC9C0\uB9CC \uD0C0\uB85C \uC544\uC800\uC528\uB791
      \uC624\uB798 \uC0B4\uC544\uC11C \uADF8\uB7F0\uC9C0 \uC7A5\uB09C\uAE30\uAC00
      \uB9E4\uC6B0 \uB9CE\uB2E4.\n\uC5B8\uC81C \uD55C\uBC88 \uB098\uC774\uB97C \uBB3C\uC5B4\uBD24\uC5C8\uB294\uB370,
      17\uC0B4\uC774\uB77C\uACE0 \uD558\uBA70 \uB0B4 \uB098\uC774\uB3C4 \uBB3C\uC5B4\uBD24\uC5C8\uB2E4.\n\uC798
      \uBAA8\uB978\uB2E4\uACE0 \uB2F5\uD558\uC790 \uADF8\uB7FC \uC774\uC81C \uC790\uAE30\uB97C
      \uB204\uB098\uB77C\uACE0 \uBD80\uB974\uB77C\uACE0 \uD558\uB354\uB77C.\n\uB098\uB3C4
      \uB0B4 \uB098\uC774\uB294 \uC798 \uBAA8\uB978\uB2E4\uB9CC \uB3D9\uAC11\uCBE4
      \uB418\uC9C0 \uC54A\uC744\uAE4C \uC2F6\uC740\uB370 \uC2DC\uB3C4\uB54C\uB3C4
      \uC5C6\uC774 \uADF8\uB7EC\uACE0 \uC788\uB2E4. \uC65C\uADF8\uB7EC\uB294\uAC70\uC57C??\n\uC77C\uBD80\uB7EC
      \uC774\uB984\uC73C\uB85C\uB9CC \uBD80\uB974\uB294 \uC911\uC774\uB2E4.\n\n\uD0C0\uB85C
      \uC544\uC800\uC528\uB97C \uAD49\uC7A5\uD788 \uC88B\uC544\uD55C\uB2E4.\n\uC544\uC800\uC528\uAC00
      \uC8FC\uBB34\uC2E4 \uB54C \uC0C8\uBCBD\uC5D0 \uC774\uC57C\uAE30\uB97C \uAE38\uAC8C
      \uD55C \uC801\uC774 \uC788\uC5C8\uB294\uB370, \uADF8\uB54C \uC11C\uB85C \uBE44\uBC00\uC744
      \uB9D0\uD558\uAE30\uB85C \uD588\uB2E4.\n\uB098\uB9CC \uC54C\uACE0 \uC788\uC73C\uB77C\uACE0
      \uB9D0\uD558\uAE30\uB97C, \uD0C0\uB85C \uC544\uC800\uC528\uB97C \uC815\uB9D0\uB85C
      \uC88B\uC544\uD55C\uB2E4\uACE0 \uB9D0\uD588\uB2E4. \uC9C4\uC9DC\uB85C!\n\uADF8\uB7EC\uBA74\uC11C
      \uC6B8\uBA74\uC11C, \uC790\uAE30\uAC00 \uC5BC\uB9C8\uB098 \uB178\uB825\uD558\uACE0
      \uC788\uB294\uC9C0 \uC544\uB0D0\uACE0, \uC5B4\uB9B4 \uB54C \uBC1B\uC740 \uC190\uC218\uAC74\uC744
      \uB9E8\uB0A0 \uBAA9\uC5D0 \uB9E4\uACE0 \uB2E4\uB2CC\uB2E4\uACE0...............
      \uD588\uB2E4.\n\uC544\uB2C8, \uADF8\uB798\uC11C \uB9E4\uACE0\uB2E4\uB2CC \uAC70\uC600\uC5B4?
      \uADF8\uAC70 \uC720\uD639 \uCD95\uC5D0 \uB4E4\uAE30\uB294 \uD558\uB294\uAC70\uC57C?\n\uAC00\uACC4\uB3C4
      \uB9DD\uCE58\uAE30\uC5D0 \uAE4A\uAC8C \uAD00\uC5EC\uB294 \uC548\uD560\uAC70\uC9C0\uB9CC
      \uC138\uB7FD\uC774 \uBABB \uCC38\uACE0 \uC774\uC57C\uAE30\uD560 \uB54C\uB9C8\uB2E4
      \uAC00\uB054 \uB4E4\uC5B4\uC8FC\uBA74\uC11C \uC704\uB85C\uD558\uACE0 \uC788\uB2E4.\n\uC774\uBBF8
      \uAE4A\uAC8C \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uB294\uB370
      \uC5B4\uB5A1\uD558\uACA0\uC5B4."
    birthday: 46246
  - name: "\uC5D0\uB974\uD06C"
    text: "\uBC14\uB974\uACE0\uB124\uC2A4\uC5D0 \uBB3C\uACE0\uAE30\uB97C \uB0A9\uD488\uD574\uC8FC\uC2DC\uACE0,
      1\uCE35 \uC790\uACBD\uB2E8\uC758 \uB9AC\uB354\uB97C \uB9E1\uACE0 \uACC4\uC2E0
      \uBD84\uC774\uB2E4.\n\uBA87 \uB144 \uC804\uAE4C\uC9C4 \uD5C8\uD06C\uB974\uCE58
      \uD574\uAD70\uC5D0\uC11C \uB192\uC740 \uC790\uB9AC\uB85C \uC77C\uD558\uC168\uB294\uB370
      \uB208\uC744 \uB2E4\uCE58\uACE0 \uC81C\uB300\uD558\uC168\uB2E4\uACE0 \uD55C\uB2E4.\n\uADF8\uB7FC\uC5D0\uB3C4
      \uC0AC\uACA9 \uC2E4\uB825\uC740 \uAD49\uC7A5\uD788 \uB6F0\uC5B4\uB098\uC2DC\uB2E4.
      \uC548 \uB2E4\uCCE4\uC73C\uBA74 \uD45C\uC801\uC774 \uBB50\uB4E0\uAC04\uC5D0
      \uB2E4 \uAFF0\uB6AB\uC744 \uC218 \uC788\uC5C8\uB2E4\uACE0 \uD558\uC2DC\uB294\uB370..
      \uC9C4\uC9E4\uAE4C?\n\n\uB9C8\uB974\uBCA8\uC740 \uC5B4\uB9B4 \uB54C\uBD80\uD130
      \uC0B4\uB358 \uACE0\uD5A5\uC774\uC2DC\uB77C\uACE0 \uD55C\uB2E4.\n\uAD49\uC7A5\uD788
      \uC870\uC6A9\uD558\uACE0 \uCE74\uB9AC\uC2A4\uB9C8 \uC788\uB294 \uC131\uACA9\uC774\uC2DC\uB2E4.
      \uC5ED\uC2DC \uAD70\uB300 \uB192\uC740\uBD84\uB4E4\uC740 \uB2E4 \uC131\uACA9\uC774
      \uC2DC\uD06C\uD574\uC57C \uD558\uB294 \uAC78\uC9C0\uB3C4. \n\n\uC6B0\uB9AC
      \uAC00\uAC8C \uC0DD\uC120 \uD0C0\uCF54\uC758 \uC720\uC77C\uD55C \uB2E8\uACE8
      \uC190\uB2D8\uC774\uB2E4.\n\uC624\uC8FD\uD558\uBA74 \uD0C0\uB85C \uC544\uC800\uC528\uAC00
      \uC5D0\uB974\uD06C \uC528\uAC00 \uC62C \uB54C\uB9C8\uB2E4 \uB208\uC5D0 \uC0DD\uAE30\uAC00
      \uB3CC\uC558\uC744\uAE4C.\n\uD558\uC9C0\uB9CC \uC5D0\uB974\uD06C \uC528\uB9CC\uC744
      \uC704\uD574 \uC0DD\uC120 \uD0C0\uCF54\uB97C \uACC4\uC18D \uBA54\uB274\uC5D0
      \uB458 \uC21C \uC5C6\uC5B4\uC11C.. \uAC00\uB054 \uD2B9\uC81C\uB85C \uB9CC\uB4E4\uC5B4\uB4DC\uB9AC\uACE0\uB9CC
      \uC788\uB2E4.\n\n\uC804\uD22C\uB825\uC774 \uCD9C\uC911\uD558\uC154\uC11C \uBC14\uB2E4\uC5D0\uC11C
      \uC0DD\uC120\uC744 \uC7A1\uC544\uC62C \uC218 \uC788\uB294 \uBA87 \uC548\uB418\uB294
      \uC0AC\uB0E5\uAFBC \uC911 \uD55C \uBD84\uC774\uC2DC\uB2E4. \n\uC0AC\uC2E4 \uC778\uC5B4\uAC00
      \uC9C4\uC9DC \uC788\uB294\uC9C0\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC
      \uC804\uC7C1\uC758 \uAE30\uC5B5 \uB54C\uBB38\uC5D0 \uB9C8\uB974\uBCA8 \uC0AC\uB78C\uB4E4\uC740
      \uBC14\uB2E4 \uAE4A\uC740 \uACF3\uC744 \uB450\uB824\uC6CC\uD558\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\uAC8C\uB2E4\uAC00
      \uAD70\uB300 \uACBD\uD5D8\uAE4C\uC9C0 \uC788\uC73C\uC154\uC11C \uC790\uC5F0\uC2A4\uB808
      \uC790\uACBD\uB2E8\uC758 \uB9AC\uB354\uB85C \uCD94\uB300\uB418\uC168\uB2E4.\n\uC544\uBB34\uB798\uB3C4
      \uC628\uC804\uD558\uC9C0\uB3C4 \uC54A\uC740 \uD574\uAD70\uC774 \uC774 \uCE35\uC758
      \uBAA8\uB4E0 \uACF5\uAC04\uC744 \uC2E0\uACBD\uC4F8 \uC21C \uC5C6\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\uC815\uC791
      \uAD00\uB9AC\uC790\uB294 \uC790\uACBD\uB2E8\uC774\uB77C\uB294 \uC870\uC9C1\uC774
      \uAF64\uB098 \uAEC4\uB044\uB7EC\uC6B4 \uAC83 \uAC19\uC9C0\uB9CC.\n"
    birthday: "\uC548\uC54C\uB824\uC8FC\uC2EC"
  - name: "\uC62C\uD398"
    text: "\uC9C0\uAE08\uC740 \uC801\uACE0\uC2F6\uC9C0 \uC54A\uB2E4."
    birthday: 
  - name: 
    text: 
    birthday: 
